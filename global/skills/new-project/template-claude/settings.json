{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pacman *)",
      "Bash(yay *)",
      "Bash(paru *)",
      "Bash(systemctl *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(cargo add *)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "gh auth status *",
      "gh pr create *",
      "gh pr view *",
      "gh pr list *",
      "gh repo create *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com",
        "*.githubusercontent.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.azure",
        "~/.kube",
        "~/.config/gh",
        "~/.git-credentials",
        "~/.docker/config.json",
        "~/.npmrc",
        "~/.pypirc",
        "~/.gem/credentials",
        "~/.local/share/keyrings",
        "~/.claude/.credentials.json"
      ]
    }
  }
}
